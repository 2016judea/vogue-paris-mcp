{
  "cleanUrls": true,
  "outputDirectory": "public",
  "buildCommand": "echo build",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "destination": "/api/openai-challenge"
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
